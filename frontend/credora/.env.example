# Backend API (Spring Boot)
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8080
# Vercel — public API URL (required for Google sign-in and the dashboard)
API_URL=https://your-backend.example.com
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# NextAuth (Google OAuth handshake)
# Local:
NEXTAUTH_URL=http://localhost:3000
# Vercel:
# NEXTAUTH_URL=https://credora-fawn.vercel.app
NEXTAUTH_SECRET=replace-with-a-32-char-secret

# Google OAuth — create a Web client in Google Cloud Console
# Local origin:  http://localhost:3000
# Local redirect: http://localhost:3000/api/auth/callback/google
# Vercel origin:  https://credora-fawn.vercel.app
# Vercel redirect: https://credora-fawn.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
