# Backend API (Spring Boot)
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8080
# After Render is live (example):
# API_URL=https://credora-api.onrender.com
# NEXT_PUBLIC_API_URL=https://credora-api.onrender.com

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Vercel: NEXTAUTH_URL=https://credora-fawn.vercel.app
NEXTAUTH_SECRET=replace-with-a-32-char-secret

# Google OAuth Web client
# Local redirect:  http://localhost:3000/api/auth/callback/google
# Vercel redirect: https://credora-fawn.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
